CREATE TABLE User (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    username TEXT NOT NULL
);

CREATE TABLE LocalTraining (
    id TEXT NOT NULL PRIMARY KEY,
    username TEXT NOT NULL,
    rawText TEXT NOT NULL,
    distanceKm REAL NOT NULL,
    durationMin REAL NOT NULL,
    timestamp INTEGER NOT NULL,
    synced INTEGER NOT NULL DEFAULT 0
);

-- User Queries
insertUser:
INSERT INTO User(username) VALUES (?);

getLastUser:
SELECT * FROM User ORDER BY id DESC LIMIT 1;

-- Training Queries
insertTraining:
INSERT OR REPLACE INTO LocalTraining(id, username, rawText, distanceKm, durationMin, timestamp, synced)
VALUES (?, ?, ?, ?, ?, ?, ?);

getUnsyncedTrainings:
SELECT * FROM LocalTraining WHERE synced = 0;

markAsSynced:
UPDATE LocalTraining SET synced = 1 WHERE id = ?;

getAllTrainings:
SELECT * FROM LocalTraining WHERE username = ? ORDER BY timestamp DESC;
